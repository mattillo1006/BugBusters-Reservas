@model SistemaDeReservas.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Iniciar sesión</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/img/icono.png" asp-append-version="true" />
</head>
<body>

    <div class="lava" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span>
    </div>

    <main class="login-tarjeta">
        <div class="login-imagen"></div>

        <section class="login-formulario">
            <img
                class="Utn-image"
                src="/img/UTN-Logo-2.jpg"
                />
            <h1>Inicio de Sesion</h1>

            <form asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <div asp-validation-summary="ModelOnly" class="login-error"></div>

                <div class="campo">
                    <label asp-for="Username">Usuario</label>
                    <input asp-for="Username" autocomplete="username" />
                    <span asp-validation-for="Username" class="login-error"></span>
                </div>

                <div class="campo">
                    <label asp-for="Password">Contraseña</label>
                    <div class="input-password">
                        <input asp-for="Password" autocomplete="current-password" />
                        <button type="button" id="togglePassword" class="toggle-password"
                                aria-label="Mostrar contraseña" title="Mostrar contraseña">
                            <svg id="iconoOjo" viewBox="0 0 24 24" width="22" height="22" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="login-error"></span>
                </div>

                <button type="submit" class="login-boton">Inicio</button>
            </form>
        </section>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
            const inputPassword = document.getElementById('Password');
            const btnToggle = document.getElementById('togglePassword');
            const iconoOjo = document.getElementById('iconoOjo');

            const OJO = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
            const OJO_TACHADO = '<path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19M14.12 14.12a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>';

            btnToggle.addEventListener('click', () => {
                const mostrar = inputPassword.type === 'password';
                inputPassword.type = mostrar ? 'text' : 'password';
                iconoOjo.innerHTML = mostrar ? OJO_TACHADO : OJO;
                const texto = mostrar ? 'Ocultar contraseña' : 'Mostrar contraseña';
                btnToggle.setAttribute('aria-label', texto);
                btnToggle.title = texto;
            });
    </script>
</body>
</html>