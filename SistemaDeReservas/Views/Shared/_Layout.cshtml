@{
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Sistema de Reservas</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/img/icono.png" asp-append-version="true" />
</head>
<body>
    <header class="navbar">
        <a class="navbar-marca" asp-controller="Home" asp-action="Index">Sistema de Reservas</a>

        <button class="navbar-toggle" type="button" aria-label="Abrir menú"
                onclick="document.querySelector('.navbar-menu').classList.toggle('abierto')">
            ☰
        </button>

        <nav class="navbar-menu">
            <a asp-controller="Home" asp-action="Index"
               class="@(controlador == "Home" ? "activo" : "")">Home</a>
            <a asp-controller="Reservas" asp-action="Index"
               class="@(controlador == "Reservas" ? "activo" : "")">Mis reservas</a>
            <a asp-controller="Account" asp-action="Index"
               class="@(controlador == "Account" ? "activo" : "")">Cuenta</a>

            <form asp-controller="Account" asp-action="Logout" method="post" class="navbar-salir">
                <button type="submit">Cerrar sesión</button>
            </form>
        </nav>
    </header>

    <main class="contenedor">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>